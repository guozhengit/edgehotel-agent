# EdgeHotel-Agent / MCP Server 环境变量清单（M6-3，.env 供 docker compose --env-file 使用）
# 复制为 .env 后按商家填写；全部变量有默认值，最小启动只需改带 ⚠ 的项。

# ===== edgehotel-agent（主应用）=====
EH_PORT=8600
EH_LLM_BASE_URL=http://host.docker.internal:1234/v1
EH_AGENT_MODEL=google/gemma-4-e4b    # 常驻骨干；30B（临时加载档）经 qwen3-30b-a3b 指定
EH_COMPLAINT_MODEL=google/gemma-4-e4b  # 可选 qwen2.5-0.5b-instruct（快筛 0.18s）或 qwen/qwen3.5-9b（他机可用）
EH_EMB_MODEL=text-embedding-qwen__qwen3-embedding-0.6b
EH_DB_PATH=data/edgehotel.db
EH_MAX_ROUNDS=3
EH_CHAT_TIMEOUT=120
EH_PREFLIGHT=warn                # off|warn|enforce（试点建议 enforce）
EH_TEMPLATE=hotel                # hotel|restaurant
EH_TENANT_ID=default             # ⚠ 每商家唯一（审计字段）
# MCP 数据源模式（可选）
EH_MCP_ENABLED=false
EH_MCP_URL=http://host.docker.internal:8601/mcp
# 渠道接入（可选）
EH_CHANNEL_ENABLED=false         # ⚠ 启用渠道时必须配 EH_CHANNEL_SECRET
EH_CHANNEL_SECRET=
EH_CHANNEL_ECHO=false
EH_CHANNEL_RATE_LIMIT=30
EH_FEISHU_ENABLED=false
EH_FEISHU_ENCRYPT_KEY=
EH_FEISHU_VERIFICATION_TOKEN=
EH_FEISHU_APP_ID=
EH_FEISHU_APP_SECRET=
EH_WECOM_ENABLED=false
EH_WECOM_TOKEN=
EH_WECOM_ENCODING_AES_KEY=    # 43 字符
EH_WECOM_RECEIVE_ID=          # 即 CorpID
EH_WECOM_CORP_ID=
EH_WECOM_CORP_SECRET=
EH_DINGTALK_ENABLED=false
EH_DINGTALK_APP_SECRET=
EH_DINGTALK_AES_KEY=

# ===== edgehotel-mcp-server（MCP 服务）=====
EH_MCP_PMS=demo                  # demo|aurora（⚠ 试点接真实 PMS 用 aurora）
EH_MCP_PMS_URL=http://host.docker.internal
EH_MCP_PMS_TENANT=1              # ⚠ aurora 多租户头 X-Merchant-Id
EH_MCP_AUTH_TOKEN=               # ⚠ 非本机部署必填（Bearer 门禁）
EH_MCP_DATA=                     # 外置 JSON 数据源路径（挂载到 /app/data）
