<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.edgehotel</groupId>
    <artifactId>edgehotel-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>edgehotel-agent</name>
    <description>EdgeHotel 酒店私域运营 AI Agent - M0-2 最小工程（AgentScope Java 2.0 + LM Studio）</description>

    <properties>
        <java.version>17</java.version>
        <agentscope.version>2.0.4-SNAPSHOT</agentscope.version>
    </properties>

    <dependencies>
        <!-- AgentScope Java 2.0：HarnessAgent（工作区/会话持久化/记忆压缩/子agent） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- 官方 OpenAI 兼容 Starter：自动装配 OpenAIChatModel（对接 LM Studio） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-openai-spring-boot-starter</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- 官方飞书渠道扩展（M4）：复用其回调加解密（FeishuCrypto），薄接入本工程渠道层 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-channel-feishu</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- WebFlux：响应式 HTTP 入口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- SQLite：审批/失败台账/记忆落库（M2-1，零运维本地库） -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
